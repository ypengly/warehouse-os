# Copy to .env before running `docker compose up --build`.

DATABASE_NAME=warehouseos
DATABASE_USERNAME=warehouseos
DATABASE_PASSWORD=change-me-locally
DATABASE_PORT=5432

BACKEND_PORT=8080

# Base64-encoded, at least 32 bytes. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=

# Never enable seed data outside local development.
SEED_ENABLED=true

CORS_ALLOWED_ORIGINS=http://localhost:5173
